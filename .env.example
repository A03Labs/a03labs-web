# Contact form delivery
#
# Enquiries go out through FormSubmit.co — no API key or DNS setup needed.

# FormSubmit's form key. Stands in for the destination inbox, which is
# configured on FormSubmit's side rather than here.
FORMSUBMIT_KEY=5c850eb28e97405cf5756d49b91a6cb6

# Sent as the Origin/Referer on the FormSubmit call. FormSubmit rejects
# requests without one ("open this page through a web server"), and the
# server-to-server call has no browser to set it for us.
SITE_URL=https://a03labs.com
